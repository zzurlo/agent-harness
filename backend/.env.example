# Foundry project endpoint (required)
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>

# Local dev auth. In Azure, leave unset and use managed identity.
FOUNDRY_API_KEY=

# --- Model routing. Override with YOUR deployment names. ---------------------
# Verify pricing + tool-calling support in the Foundry catalog for your region.
MODEL_FAST=Phi-4-mini-reasoning
MODEL_CHAT=Llama-3.3-70B-Instruct
MODEL_TOOLS=grok-4.1-fast-reasoning
MODEL_THINK=DeepSeek-V4-Flash
MODEL_MAX=DeepSeek-V3.2

# --- Budgets -----------------------------------------------------------------
MAX_TOOL_CALLS=8
MAX_WALL_CLOCK=120
MAX_TURN_TOKENS=60000
MAX_TOOL_SECONDS=30

# --- Context -----------------------------------------------------------------
WORKING_WINDOW=24000
COMPACT_AT_RATIO=0.70
KEEP_RECENT=6

# --- Misc --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
TABLES_CONNECTION_STRING=
LOG_LEVEL=INFO
