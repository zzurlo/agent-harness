# Explicit MODEL endpoint, not the Agent Service project URL.
FOUNDRY_MODEL_ENDPOINT=https://your-resource.openai.azure.com/openai/v1

# Local inference authentication (optional). In Azure, use managed identity.
FOUNDRY_API_KEY=

# Required private owner key, random >=32 non-whitespace characters.
# Generate privately; never commit the real value or put it in VITE_* variables.
APP_ACCESS_TOKEN=

# Replace with actual deployment names. These are not catalog recommendations.
# Several routes can share one compatible model. Match capability flags in config.py.
MODEL_FAST=your-fast-deployment
MODEL_CHAT=your-nonreasoning-chat-deployment
MODEL_TOOLS=your-tool-capable-deployment
MODEL_THINK=your-reasoning-deployment
MODEL_MAX=your-strong-tool-capable-deployment

MAX_TOOL_CALLS=8
MAX_WALL_CLOCK=120
MAX_TURN_TOKENS=60000
MAX_TOOL_SECONDS=30
WORKING_WINDOW=24000
COMPACT_AT_RATIO=0.70
KEEP_RECENT=6

CORS_ORIGINS=http://localhost:5173
TABLES_CONNECTION_STRING=
LOG_LEVEL=INFO
